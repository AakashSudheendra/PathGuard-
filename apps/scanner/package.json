{
  "name": "@pathguard/scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test ../../tests/*.test.ts",
    "scan:fixture": "tsx src/index.ts --lockfile ../../tests/fixtures/vulnerable-package-lock.json --out pathguard-fixture-results.json"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6"
  }
}